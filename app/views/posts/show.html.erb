<div class="container bg-secondary">
  <%= render 'shared/titles_and_votes', post: @post %>

  <%= turbo_frame_tag "comments_#{@post.id}" do %>
    <div class="px-4 mt-3 mb-3">

      <%= render 'posts/form_comment', post: @post, comment: @comment %>

    </div>
    <div >
      <% @comments.each do |comment| %>
      <div>

        <%= render 'posts/comment_display', comment: comment %>

      </div>
      <% end %>
    </div>
  <% end %>
  </div>
</div>
<% content_for :title, @post.title %>
